# Dependencies
node_modules/

# Build output
.next/
out/
dist/

# Visual-regression captures — regenerate with `npm run snapshot`.
# Forty-eight full-page PNGs per run, about 62MB; they are evidence,
# not source.
#
# The pattern is a leading dot rather than a list of names. It used to
# be `.baseline/`, `.after*/`, `.control/` — a list — and the next run
# was called `.final`, which matched none of them and put 62MB of PNGs
# into the repository. A capture directory is anything hidden at the
# root that is not configuration, so name them that way and the rule
# holds for the one nobody has thought of yet.
.baseline/
.next-out/
.after*/
.control/
.final/
.snapshot*/

# TypeScript's incremental build cache. Regenerated by `tsc`, machine-
# specific, and pure churn in a diff.
tsconfig.tsbuildinfo

# Local scratch
*.log
.DS_Store
Thumbs.db

# Generated, and checked in on purpose:
#   src/lib/image-fallbacks.generated.ts
# It is written by scripts/images.mjs at the start of every build, but it
# is also the thing `tsc` needs to typecheck the app, so a clone without
# it cannot even be linted until someone runs the build. Committed.
